{
  "pipeline_version": "1.0.0",
  "description": "Atlantoaxial Disease Classification Pipeline",

  "yolo": {
    "model": "yolov8s",
    "weights": "yolo_best.pt",
    "task": "spine_roi_detection",
    "conf_threshold": 0.25,
    "imgsz": 640
  },

  "binary": {
    "model": "resnet50",
    "weights": "binary_best.pt",
    "task": "disease_presence",
    "n_classes": 1,
    "labels": ["Normal", "Disease"],
    "threshold": 0.5,
    "val_metrics": {
      "auc": 0.9938,
      "acc": 0.9684,
      "f1": 0.9779,
      "ece": 0.0210
    }
  },

  "multilabel": {
    "model": "resnet50",
    "weights": "multilabel_best.pt",
    "task": "disease_classification",
    "n_classes": 6,
    "threshold": 0.5,
    "labels_en": [
      "Anterior AAD",
      "Posterior AAD",
      "Basilar Invagination (BI)",
      "Os Odontoideum (OO)",
      "Occipitalization of Atlas",
      "C2-3 Non-segmentation"
    ],
    "labels_cn": [
      "寰椎前脱位",
      "寰椎后脱位",
      "颅底凹陷",
      "齿突不连",
      "寰椎枕化",
      "颈2-3分节不全"
    ],
    "mutex_pairs": [
      ["Anterior AAD", "Posterior AAD"]
    ],
    "val_metrics": {
      "f1_macro": 0.8926,
      "f1_micro": 0.9071,
      "exact_match": 0.7060,
      "auc_macro": 0.9648,
      "ece": 0.0544
    }
  },

  "preprocessing": {
    "image_size": 224,
    "crop_padding": 0.1,
    "normalization": {
      "mean": [0.485, 0.456, 0.406],
      "std": [0.229, 0.224, 0.225]
    }
  },

  "external_validation": {
    "datasets": {
      "prospective": {
        "n_images": 266,
        "multilabel_f1_macro": 0.8868,
        "multilabel_auc_macro": 0.9612,
        "binary_auc": 0.9119
      },
      "multi_center": {
        "n_images": 643,
        "n_hospitals": 4,
        "multilabel_f1_macro": 0.8091,
        "multilabel_auc_macro": 0.9329,
        "binary_auc": 0.8340
      }
    }
  }
}
